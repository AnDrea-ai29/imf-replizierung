library(tidyverse)
# 1. ISO-Codes einlesen (nur relevante Spalten)
iso_codes <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/country_codes_wdi-iso-itu.csv") %>%
select(wdi_short_name, iso_3ltr) %>%
rename(Country = wdi_short_name, ISO3 = iso_3ltr) %>%
filter(!is.na(ISO3))  # Nur Zeilen mit gültigem ISO3-Code
# 2. UNSC-Rohdaten einlesen
unsc_raw <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/unsc/DPPA-SCMembership.csv")
# 3. Länder mit ISO-Codes verknüpfen
# Hinweis: Falls "Country" in unsc_raw anders heißt (z. B. "Country.Name"), anpassen!
unsc_with_iso <- unsc_raw %>%
left_join(iso_codes, by = "Country") %>%  # Verknüpfung über Ländername
mutate(
# ISO3-Code manuell für häufige Fälle ergänzen (falls Verknüpfung fehlschlägt)
ISO3 = case_when(
is.na(ISO3) & Country == "United States" ~ "USA",
is.na(ISO3) & Country == "United Kingdom" ~ "GBR",
is.na(ISO3) & Country == "Russia" ~ "RUS",
is.na(ISO3) & Country == "China" ~ "CHN",
is.na(ISO3) & Country == "France" ~ "FRA",
is.na(ISO3) & Country == "Germany" ~ "DEU",
is.na(ISO3) & Country == "Japan" ~ "JPN",
is.na(ISO3) & Country == "India" ~ "IND",
is.na(ISO3) & Country == "Brazil" ~ "BRA",
TRUE ~ ISO3  # Sonst behalten
),
# Mitgliedschaft codieren: 1 = Mitglied (Permanent/Non-Permanent), 0 = Nicht-Mitglied
unsc = ifelse(Member.Type %in% c("Permanent", "Non-Permanent"), 1, 0)
) %>%
# Nur relevante Spalten behalten
select(ISO3, Country, Year, Member.Type, unsc) %>%
# Nur 2002–2025 behalten
filter(Year >= 2002, Year <= 2025) %>%
# Zeilen mit fehlendem ISO3 entfernen
filter(!is.na(ISO3))
View(unsc_raw)
View(unsc_raw)
# 3. Länder mit ISO-Codes verknüpfen
# Hinweis: Falls "Country" in unsc_raw anders heißt (z. B. "Country.Name"), anpassen!
unsc_with_iso <- unsc_raw %>%
left_join(iso_codes, by = "security_council_member") %>%  # Verknüpfung über Ländername
mutate(
# ISO3-Code manuell für häufige Fälle ergänzen (falls Verknüpfung fehlschlägt)
ISO3 = case_when(
is.na(ISO3) & Country == "United States" ~ "USA",
is.na(ISO3) & Country == "United Kingdom" ~ "GBR",
is.na(ISO3) & Country == "Russia" ~ "RUS",
is.na(ISO3) & Country == "China" ~ "CHN",
is.na(ISO3) & Country == "France" ~ "FRA",
is.na(ISO3) & Country == "Germany" ~ "DEU",
is.na(ISO3) & Country == "Japan" ~ "JPN",
is.na(ISO3) & Country == "India" ~ "IND",
is.na(ISO3) & Country == "Brazil" ~ "BRA",
TRUE ~ ISO3  # Sonst behalten
),
# Mitgliedschaft codieren: 1 = Mitglied (Permanent/Non-Permanent), 0 = Nicht-Mitglied
unsc = ifelse(Member.Type %in% c("Permanent", "Non-Permanent"), 1, 0)
) %>%
# Nur relevante Spalten behalten
select(ISO3, Country, Year, Member.Type, unsc) %>%
# Nur 2002–2025 behalten
filter(Year >= 2002, Year <= 2025) %>%
# Zeilen mit fehlendem ISO3 entfernen
filter(!is.na(ISO3))
