# 1. Datei einlesen (mit Schrägstrichen)
unsc_raw <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/unsc/DPPA-SCMembership.csv")
View(unsc_raw)
View(unsc_raw)
# 2. Spaltenbenennung prüfen (falls nötig)
# Falls die Spalten andere Namen haben, anpassen:
colnames(unsc_raw)  # Ausgeben, um Spaltennamen zu prüfen
unsc_raw <- unsc_raw %>% rename(Country = `Country Name`, Year = `Year`, MemberType = `Type`)
View(unsc_raw)
View(unsc_raw)
# 3. Daten filtern und aufbereiten
unsc_2002_2025 <- unsc_raw %>%
# Nur Jahre 2002–2025 behalten
filter(Year >= 2002, Year <= 2025) %>%
# Mitgliedschaft codieren: 1 = Mitglied (Permanent oder Non-Permanent), 0 = nicht Mitglied
mutate(
unsc = ifelse(Member.Type %in% c("Permanent", "Non-Permanent"), 1, 0),
# ISO-3-Code hinzufügen (falls nicht vorhanden)
ISO3 = case_when(
Country == "United States" ~ "USA",
Country == "United Kingdom" ~ "GBR",
Country == "France" ~ "FRA",
Country == "China" ~ "CHN",
Country == "Russian Federation" ~ "RUS",
Country == "Germany" ~ "DEU",
Country == "Japan" ~ "JPN",
# Weitere Länder nach Bedarf ergänzen (siehe /data/afrika_iso_codes_wdi.csv)
TRUE ~ NA_character_
)
) %>%
# Nur relevante Spalten behalten
select(ISO3, Country, Year, Member.Type, unsc) %>%
# Leere ISO3-Codes entfernen (falls vorhanden)
filter(!is.na(ISO3))
