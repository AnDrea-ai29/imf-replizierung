library(tidyverse)
# 1. Spaltennamen in DPPA-SCMembership.csv prüfen
unsc_raw <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/unsc/DPPA-SCMembership.csv")
print(colnames(unsc_raw))  # Zeigt z.B.: "security_council_member", "year", "type"
# 2. ISO-Codes einlesen
iso_codes <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/country_codes_wdi-iso-itu.csv") %>%
select(wdi_short_name, iso_3ltr) %>%
rename(Country = wdi_short_name, ISO3 = iso_3ltr)
# 3. Verknüpfen (Spaltennamen anpassen!)
unsc_with_iso <- unsc_raw %>%
left_join(iso_codes, by = c("security_council_member" = "Country")) %>%  # Hier Spaltenname anpassen!
mutate(
ISO3 = coalesce(ISO3, case_when(
security_council_member == "United States" ~ "USA",
security_council_member == "United Kingdom" ~ "GBR",
security_council_member == "Russia" ~ "RUS",
security_council_member == "China" ~ "CHN",
security_council_member == "France" ~ "FRA",
TRUE ~ ISO3
)),
unsc = ifelse(type %in% c("Permanent", "Non-Permanent"), 1, 0)  # Hier ggf. "type" anpassen!
) %>%
select(ISO3, Country = security_council_member, Year = year, Member.Type = type, unsc) %>%
filter(Year >= 2002, Year <= 2025, !is.na(ISO3)) %>%
write_csv("C:/Users/HP/io/imf-replizierung/data/raw/unsc/unsc_membership_2002_2025.csv", na = "")
library(tidyverse)
# 1. Spaltennamen in DPPA-SCMembership.csv prüfen
unsc_raw <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/unsc/DPPA-SCMembership.csv")
print(colnames(unsc_raw))  # Beispielausgabe: "security_council_member", "year", "type"
# 2. ISO-Codes einlesen und Spalten umbenennen
iso_codes <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/country_codes_wdi-iso-itu.csv") %>%
select(wdi_short_name, iso_3ltr) %>%
rename(Country = wdi_short_name, ISO3 = iso_3ltr)
# 3. Verknüpfen und Daten bereinigen
unsc_with_iso <- unsc_raw %>%
# Join mit iso_codes: "security_council_member" (aus unsc_raw) wird mit "Country" (aus iso_codes) verknüpft
left_join(iso_codes, by = c("security_council_member" = "Country")) %>%
# ISO3 für permanente Mitglieder manuell zuweisen, falls nicht im Join enthalten
mutate(
ISO3 = coalesce(ISO3, case_when(
security_council_member == "United States" ~ "USA",
security_council_member == "United Kingdom" ~ "GBR",
security_council_member == "Russia" ~ "RUS",
security_council_member == "China" ~ "CHN",
security_council_member == "France" ~ "FRA",
TRUE ~ NA_character_  # Falls keine Übereinstimmung, NA zuweisen
)),
unsc = ifelse(type %in% c("Permanent", "Non-Permanent"), 1, 0)
) %>%
# Spalten auswählen und umbenennen
select(
ISO3,
Country = security_council_member,
Year = year,
Member.Type = type,
unsc
) %>%
# Filter: Nur Jahre 2002-2025 und gültige ISO3-Codes
filter(Year >= 2002, Year <= 2025, !is.na(ISO3)) %>%
# Speichern als CSV
write_csv("C:/Users/HP/io/imf-replizierung/data/raw/unsc/unsc_membership_2002_2025.csv", na = "")
print(colnames(unsc_raw))  # Beispielausgabe: "security_council_member", "year", "type"
Kurze Lösung für den Datensatz ohne Mitgliedschaftstyp:
library(tidyverse)
# 1. ISO-Codes einlesen
iso_codes <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/country_codes_wdi-iso-itu.csv") %>%
select(wdi_short_name, iso_3ltr) %>%
rename(Country = wdi_short_name, ISO3 = iso_3ltr)
# 2. UNSC-Rohdaten einlesen (nur Mitglieder pro Jahr)
unsc_raw <- read.csv("C:/Users/HP/io/imf-replizierung/data/raw/unsc/DPPA-SCMembership.csv")
# 3. Verknüpfen + Mitgliedschaftstyp ergänzen
unsc_2002_2025 <- unsc_raw %>%
left_join(iso_codes, by = c("security_council_member" = "Country")) %>%
mutate(
ISO3 = coalesce(ISO3, case_when(
security_council_member == "United States" ~ "USA",
security_council_member == "United Kingdom" ~ "GBR",
security_council_member == "Russia" ~ "RUS",
security_council_member == "China" ~ "CHN",
security_council_member == "France" ~ "FRA",
TRUE ~ ISO3
)),
# Alle Einträge sind Mitglieder (unsc = 1)
unsc = 1,
# Mitgliedschaftstyp: Permanente Mitglieder kennzeichnen
Member.Type = ifelse(ISO3 %in% c("USA", "GBR", "FRA", "CHN", "RUS"),
"Permanent", "Non-Permanent")
) %>%
select(ISO3, Country = security_council_member, Year = year, Member.Type, unsc) %>%
filter(Year >= 2002, Year <= 2025, !is.na(ISO3)) %>%
write_csv("C:/Users/HP/io/imf-replizierung/data/raw/unsc/unsc_membership_2002_2025.csv", na = "")
left_join(
iso_codes,
by = c("security_council_member" = "Country"),
relationship = "many-to-many"  # Warnung wird nicht mehr angezeigt
)
left_join(
iso_codes,
by = c("security_council_member" = "Country"),
relationship = "many-to-many"  # Warnung wird nicht mehr angezeigt
)
