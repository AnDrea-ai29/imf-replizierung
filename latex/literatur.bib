  doi = {10.1093/oxfordhb/9780198915874.013.0002},
  abstract = {About 30 years ago, the study of international norms emerged as a social scientific project. Political scientists had taken an interest in international law long before---around the turn of the last century---but their approach tended to follow the paths worn by international lawyers, assessing international rules in formal rather than behavioural terms. The behavioural turn shifted the focus, seeking to evaluate the effects of norms and norm contestation on political and policy outcomes. Since then, the study of norms has established itself among the core concerns in the analysis of International Relations. This chapter focuses on how international norms change in response to disputes that bring into play the shifting beliefs and interests of actors (governments, international organizations [IOs], non-governmental organizations [NGOs], activists, political entrepreneurs, and publics). The first section sketches the development of scholarly attention to international norms and the inability of previous research traditions to account for their effects. The second section addresses a central problematique in the study of international norms---specifically, how norms change through disputes and contestation. The two subsequent sections address questions raised by the dynamics of norm change: the third section focuses on norm conflict, including the interaction of norms, interests, and power; the fourth section examines norm resilience, with particular attention to the embeddedness of norms in larger clusters and to norm reversal and norm death.},
  isbn = {978-0-19-891587-4},
  keywords = {Norm definition},
  file = {C:\Users\HP\Zotero\storage\DKXKIB26\Sandholtz und Zvobgo - 2025 - The International Norms Enterprise.pdf}
}

