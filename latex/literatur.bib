@article{MitzenOntologicalSecurityWorld2006,
  title = {Ontological {{Security}} in {{World Politics}}: {{State Identity}} and the {{Security Dilemma}}},
  shorttitle = {Ontological {{Security}} in {{World Politics}}},
  author = {Mitzen, Jennifer},
  date = {2006-09},
