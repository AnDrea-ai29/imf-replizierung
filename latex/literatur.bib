@article{trueWinningBattleLosing2015,
  title = {Winning the {{Battle}} but {{Losing}} the {{War}} on {{Violence}}: {{A FEMINIST PERSPECTIVE ON THE DECLINING GLOBAL VIOLENCE THESIS}}},
  shorttitle = {Winning the {{Battle}} but {{Losing}} the {{War}} on {{Violence}}},
  author = {True, Jacqui},
  date = {2015-10-02},
  journaltitle = {International Feminist Journal of Politics},
  shortjournal = {Int. Fem. J. Polit.},
  volume = {17},
  number = {4},
  pages = {554--572},
  issn = {1461-6742, 1468-4470},
  doi = {10.1080/14616742.2015.1046269},
  abstract = {Scholars have recently claimed that global violence -- defined largely as homicide and casualties from war -- is in steep decline. However, research dedicated to using data to prove the decline of violence, in particular Steven Pinker's book, The Better Angels of Our Nature, almost completely neglects evidence of gendered violence within and across states. This methodological and analytical failure results from flawed theoretical assumptions about what violence is and how to count violent incidences. While prevalence surveys show that a large proportion of women and girls (not to mention men and boys) experience sexual and gender-based violence (SGBV), it does not appear in declinist analyses. This is especially problematic given the burgeoning evidence of SGBV's scale and significance in current conflicts, often as a ``tactic of war'' targeting civilians. Analyzing global violence from a feminist perspective thus radically challenges declinist views about trends of violence. The explicitly feminist perspective on international relations in this article provides a more universal accounting of global violence, and the contemporary changes in the nature and forms of violence.},
  langid = {english},
  file = {C:\Users\HP\Zotero\storage\Z4V4RS5N\True - 2015 - Winning the Battle but Losing the War on Violence A FEMINIST PERSPECTIVE ON THE DECLINING GLOBAL VI.pdf}
}

